# Copy to .env and fill in, or just set these in your shell.
# Everything works without them - the default 'offline' enrichment mode needs no keys.
#
#   PowerShell:  $env:ABUSEIPDB_API_KEY = "..."
#   bash:        export ABUSEIPDB_API_KEY="..."
#
# Then run with:  python soc-triage.py --intel live

# IP reputation - free tier: 1,000 checks/day  https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=

# Domain and file-hash reputation - free tier: 4 lookups/min  https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Optional: default webhook for --notify (Slack, Discord or Microsoft Teams).
# Treat this URL as a credential - anyone holding it can post to the channel.
TRIAGE_WEBHOOK_URL=
